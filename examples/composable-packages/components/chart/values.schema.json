{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\r\n]+$"
    }
  },
  "required": ["connectName", "message"]
}
