# Existing Zarf project 683708 public project token, supplied at build time.
# Leave unset to disable analytics.
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Opt in to sending real events from localhost for manual testing.
# This does not enable capture on Netlify preview hosts.
PUBLIC_POSTHOG_ENABLE_LOCAL=false

# Opt in for this site's Netlify Deploy Preview / Branch Deploy build contexts.
# Production does not need this flag. Other Netlify sites stay excluded.
PUBLIC_POSTHOG_ENABLE_PREVIEW=false
