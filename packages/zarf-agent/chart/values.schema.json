{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "clusterRole": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "clusterRoleBinding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "role": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "roleBinding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tlsCrt": {
          "type": "string"
        },
        "tlsKey": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "replicaCount": {
          "type": "integer"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullSecret": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            }
          }
        }
      }
    },
    "affinity": {
      "type": [
        "object",
        "null"
      ]
    },
    "tolerations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "webhookAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mutationPolicy": {
      "type": "string",
      "enum": [
        "all",
        "labeled",
        "###ZARF_AGENT_MUTATION_POLICY###"
      ]
    },
    "mutationExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "argocd",
          "flux"
        ]
      }
    }
  }
}
