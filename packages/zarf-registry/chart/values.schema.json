{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "customLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tlsSecretName": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer"
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "injectorHostPort": {
          "type": "integer"
        },
        "tolerations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object"
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "injector": {
          "type": "object",
          "properties": {
            "hostPort": {
              "type": "integer"
            },
            "image": {
              "type": "string"
            },
            "payLoadConfigMapAmount": {
              "type": [
                "integer",
                "string"
              ]
            },
            "shasum": {
              "type": "string"
            }
          }
        }
      }
    },
    "mtls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ipv6Only": {
      "type": "boolean"
    },
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "registryPort": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "nodePort": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer"
        },
        "fsGroup": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadOnlyMany",
            "ReadWriteMany",
            "ReadWriteOncePod"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "deleteEnabled": {
          "type": "boolean"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "htpasswd": {
          "type": "string"
        },
        "configData": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "affinity": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "custom": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "tolerations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mapReplicasToNodes": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxReplicas": {
          "type": [
            "integer",
            "string"
          ]
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "caBundle": {
      "type": "string"
    },
    "extraEnvVars": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "opentelemetry": {
      "type": "object",
      "properties": {
        "exporter": {
          "type": "string"
        }
      }
    }
  }
}
